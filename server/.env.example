# --- Multi-model access (recommended) ---
# Get a key at https://openrouter.ai/keys — one key, 100+ models.
# If OPENROUTER_API_KEY is set, it overrides OPENAI_API_KEY for chat.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL_ID=openai/gpt-4o-mini
CONSENSUS_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet,google/gemini-flash-1.5

# --- Speech-to-text ---
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_MAX_BYTES=10000000
RATE_WINDOW_MS=60000
RATE_MAX=20

# --- Image generation ---
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
